{
  "name": "mindtap-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build --base=\"/mindtap-ui/\"",
    "dev": "vite",
    "dev:cmp": "vite build --base=\"/mindtap-ui/\" --watch --sourcemap true",
    "lint": "eslint . && prettier src --check",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "postinstall": "rm -f src/store/__fixtures__/stateSnapshot.json && vitest run storeSnapshot.spec.tsx",
    "prepare": "husky install"
  },
  "dependencies": {
    "@module-federation/runtime": "^2.8.2",
    "@reduxjs/toolkit": "2.11.2",
    "@tanstack/react-virtual": "3.14.2",
    "axe-core": "4.11.4",
    "ky": "2.0.2",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "minisearch": "7.2.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-focus-lock": "2.13.7",
    "react-idle-timer": "5.7.3",
    "react-magma-dom": "4.14.0",
    "react-magma-icons": "3.2.6",
    "react-redux": "8.1.3",
    "react-router-dom": "6.30.3",
    "redux": "5.0.1",
    "uuid": "^14.0.1",
    "xss": "1.0.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@module-federation/vite": "1.16.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "12.1.5",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.1",
    "@types/node": "^24.12.2",
    "@types/react": "^17.0.91",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^17.5.0",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "jest-extended": "7.0.0",
    "lint-staged": "17.0.8",
    "msw": "2.14.5",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "4.1.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix",
    "*.{js,ts,tsx,json,html}": "prettier --write"
  }
}
